# Create an application at https://discord.com/developers/applications
# Put the bot token here locally. Never commit your real .env.
DISCORD_TOKEN=
# Leave empty for public/global commands in every server.
# Set a server ID only for development or a private instance.
DISCORD_GUILD_ID=
# When upgrading a previously server-only instance, clear its old command copies once.
LEGACY_GUILD_ID=
DATABASE_PATH=data/roundforge.sqlite3
# Development-only channel IDs; public servers configure channels with /admin channel.
BOT_CHANNEL_IDS=
# Console level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
